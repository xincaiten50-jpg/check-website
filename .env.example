# ── SSH Tunnel ──
# SSH tunnel to remote server for proxy routing.
# Auth uses a private key (public key must be in server's ~/.ssh/authorized_keys).
SSH_HOST=your_ssh_host_ip
SSH_PORT=22
SSH_USER=Administrator
# Absolute path to the private key file. A leading `~` is expanded to the
# current user's home directory.
# Windows: C:\Users\you\.ssh\check-website   | macOS/Linux: /Users/you/.ssh/check-website
SSH_KEY_PATH=

# ── Telegram ──
# Get bot token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Failure Notifications ──
# Send alert after this many consecutive failed sessions.
# Default 1 = alert immediately on the first failure (no waiting).
EMAIL_NOTIFY_FAILURE_THRESHOLD=1

# After first notification, repeat every N additional failed sessions
EMAIL_NOTIFY_REPEAT_EVERY_FAILURES=6

# Send recovery message when previously-dead links come back
EMAIL_NOTIFY_RECOVERY=true

# Max size of errors.log before rotation (bytes)
ERROR_LOG_MAX_BYTES=1048576

# ── Browser ──
# Path to a real Chrome/Chromium binary. Leave empty to let Playwright
# use its bundled Chromium.
# Examples:
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Docker:  /usr/bin/chromium
# BROWSER_EXECUTABLE_PATH=
